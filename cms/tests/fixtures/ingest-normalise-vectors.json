    {
      "referrer": "https://example.org:8443",
      "stored": "example.org"
    },
    {
      "referrer": "https://example.org:",
      "stored": "example.org"
    },
    {
      "referrer": "http://localhost:8080",
      "stored": null
    },
    {
      "referrer": "http://localhost",
      "stored": null
    },
    {
      "referrer": "http://192.168.0.1",
      "stored": null
