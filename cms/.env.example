# Environment for the two generated CMS projects. Copy the section for a target into that
# project's own .env (cms/generated/strapi/.env or cms/generated/strapi-php/.env) and fill in real
# values there. Never commit a filled-in copy: every value below is a placeholder.

# ---------------------------------------------------------------------------------------------
# strapi (local development) — cms/generated/strapi/.env
# ---------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=1337
APP_KEYS=replace-with-key-1,replace-with-key-2
API_TOKEN_SALT=replace-with-random-salt
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
TRANSFER_TOKEN_SALT=replace-with-random-salt
# users-permissions signs API sessions with this; use at least 32 random bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---------------------------------------------------------------------------------------------
# strapi-php (shared hosting) — cms/generated/strapi-php/.env
# ---------------------------------------------------------------------------------------------
# Laravel itself. APP_URL is the CMS's own origin: the refresh cookie is taken from it.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://cms.example.com
# sqlite, mysql or pgsql; no code changes between them.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=identgineer_cms
DB_USERNAME=identgineer_cms
DB_PASSWORD=replace-me
# Salts and secrets of API tokens, transfer tokens and admin sessions; random, never shared.
API_TOKEN_SALT=replace-with-random-salt
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes
TRANSFER_TOKEN_SALT=replace-with-random-salt
# Upper bound on any API token's life in minutes; refresh-mode access tokens live less (below).
SANCTUM_TOKEN_EXPIRATION=1440

# Sign-in sessions, as packages/identity needs them (its README, "Backend configuration").
# Refresh mode: short access tokens, rotating refresh tokens, server-side sessions that sign-out
# and password changes end. Without it the SDK cannot restore a session or revoke one.
CAMIS_JWT_MANAGEMENT=refresh
# Access token life in seconds; the SDK's accessTokenLifetimeSeconds must match if changed.
CAMIS_ACCESS_TOKEN_LIFESPAN=600
# A session's absolute and idle limits in seconds (30 and 14 days); the cookie lasts as long.
CAMIS_MAX_REFRESH_TOKEN_LIFESPAN=2592000
CAMIS_IDLE_REFRESH_TOKEN_LIFESPAN=1209600
# Body mode stays the default; the SDK asks for the HttpOnly cookie on each sign-in itself.
CAMIS_SESSIONS_HTTP_ONLY=false
# The refresh cookie: Secure, sent to same-site requests only, and only under /api/auth.
# Strict needs the site and the CMS on one registrable domain (identgineer.example.com and
# cms.example.com); a site on another domain needs "none".
CAMIS_SESSIONS_COOKIE_SECURE=true
CAMIS_SESSIONS_COOKIE_SAME_SITE=strict
CAMIS_SESSIONS_COOKIE_PATH=/api/auth

# CORS. The sites that call the authenticated API, comma-separated https origins. Never "*":
# with "*" no origin gets credentials, so the SDK's cookie sign-in, refresh and logout fail, and
# a listed origin is also the only foreign page the refresh cookie is taken from. Tracking
# beacons do not need to be listed (see cms/README.md, "Event ingestion").
CAMIS_CORS_ORIGIN=https://identgineer.example.com
# The request headers the SDK sends (its CSRF headers among them), and Retry-After exposed so a
# throttled client reads how long to wait.
CAMIS_CORS_HEADERS=Content-Type,Authorization,Origin,Accept,X-Requested-With,x-strapi-refresh-cookie
CAMIS_CORS_EXPOSE=Retry-After

# Throttles, per minute: each credential route group per client address (sign-in, recovery and
# confirmation mail also per name given), the per-address ceiling across names, and failed
# refreshes. Raise the ceiling for an office behind one address; behind a proxy, trust it in
# bootstrap/app.php (generated DEPLOY.md, "Sign-in sessions") or every client shares its address.
CAMIS_AUTH_THROTTLE_PER_MINUTE=10
CAMIS_AUTH_ADDRESS_THROTTLE_PER_MINUTE=50
CAMIS_REFRESH_THROTTLE_PER_MINUTE=60

# Account email. With confirmation on, registration hides whether an address was taken (the
# SDK resolves both alike); off, a new account is signed in at once. The links point at the site.
CAMIS_EMAIL_CONFIRMATION=true
CAMIS_EMAIL_RESET_PASSWORD_URL=https://identgineer.example.com/reset-password
CAMIS_EMAIL_CONFIRMATION_REDIRECTION=https://identgineer.example.com/signed-in
# How mail leaves the CMS (smtp in production; log writes it to storage/logs for development).
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=identity@example.com

# Uploads: images only, no SVG (it can carry script), at most 2 MB.
CAMIS_UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp
CAMIS_UPLOAD_SIZE_LIMIT=2097152

# ---------------------------------------------------------------------------------------------
# Ingestion handlers (both targets). Read by the hand-written handlers in cms/protected once they
# exist (Feature 9); nothing reads them yet.
# ---------------------------------------------------------------------------------------------
INGEST_RATE_PER_MINUTE=120
INGEST_MAX_BODY_BYTES=8192
INGEST_MAX_PROPERTIES_BYTES=2048
