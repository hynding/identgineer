{
  "$description": "Brand theme for Harbour Lights",
  "$extensions": {
    "identgineer": {
      "label": "Harbour Lights",
      "brand": {
        "typography": "classic-serif",
        "corners": "round",
        "tone": "vivid",
        "colors": {
          "primary": "#f4c430",
          "neutralTint": "#1b2a4a"
        },
        "radius": {
          "$type": "dimension",
          "sm": {
            "$value": "0.5rem"
          },
          "md": {
            "$value": "1rem"
          },
          "lg": {
            "$value": "1.5rem"
          },
          "pill": {
            "$value": "9999px"
          }
        }
      }
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": [
            "Iowan Old Style",
            "Palatino Linotype",
            "Palatino",
            "Book Antiqua",
            "Georgia",
            "serif"
          ]
        },
        "body": {
          "$value": [
            "system-ui",
            "Segoe UI",
            "Roboto",
            "Helvetica Neue",
            "Arial",
            "sans-serif"
          ]
        },
        "mono": {
          "$value": [
            "ui-monospace",
            "SF Mono",
            "Cascadia Code",
            "Menlo",
            "Consolas",
            "DejaVu Sans Mono",
            "Liberation Mono",
            "monospace"
          ]
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": 600
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.2
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
