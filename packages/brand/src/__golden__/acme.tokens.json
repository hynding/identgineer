{
  "$description": "Up, up \u0026 away!",
  "$extensions": {
    "identgineer": {
      "label": "Acme Rockets",
      "brand": {
        "typography": "geometric",
        "corners": "soft",
        "tone": "balanced",
        "colors": {
          "primary": "#4f46e5",
          "secondary": "#0f766e"
        },
        "radius": {
          "$type": "dimension",
          "sm": {
            "$value": "0.25rem"
          },
          "md": {
            "$value": "0.5rem"
          },
          "lg": {
            "$value": "0.75rem"
          },
          "pill": {
            "$value": "9999px"
          }
        }
      }
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": [
            "Avenir Next",
            "Avenir",
            "Century Gothic",
            "Futura",
            "Segoe UI",
            "system-ui",
            "sans-serif"
          ]
        },
        "body": {
          "$value": [
            "system-ui",
            "Segoe UI",
            "Roboto",
            "Helvetica Neue",
            "Arial",
            "sans-serif"
          ]
        },
        "mono": {
          "$value": [
            "ui-monospace",
            "SF Mono",
            "Cascadia Code",
            "Menlo",
            "Consolas",
            "DejaVu Sans Mono",
            "Liberation Mono",
            "monospace"
          ]
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": 600
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "-0.02em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.15
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.6
        }
      }
    }
  },
