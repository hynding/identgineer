{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "www",
    "loader",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/testing"
  ]
}
