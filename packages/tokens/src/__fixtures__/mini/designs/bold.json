{
  "$description": "A fixture design with an opaque fallback.",
  "$extensions": { "identgineer": { "label": "Bold" } },
  "tokens": {
    "shape": { "radius": { "md": { "$type": "dimension", "$value": "0" } } },
    "border": { "style": { "$type": "string", "$value": "double" } },
    "surface": {
      "background": {
        "$type": "string",
        "$value": "color-mix(in srgb, var(--idg-color-surface) 50%, transparent)"
      }
    }
  },
  "opaque": {
    "surface": { "background": { "$type": "string", "$value": "var(--idg-color-surface)" } }
  }
}
