{
  "$description": "Material-like layers: stacked soft shadows, no borders and a modest radius.",
  "$extensions": {
    "identgineer": {
      "label": "Elevated",
      "followsBrandCorners": true
    }
  },
  "tokens": {
    "shape": {
      "$type": "dimension",
      "radius": {
        "sm": {
          "$value": "0.25rem"
        },
        "md": {
          "$value": "0.375rem"
        },
        "lg": {
          "$value": "0.5rem"
        },
        "pill": {
          "$value": "9999px"
        }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": "0"
      },
      "style": {
        "$type": "string",
        "$value": "none"
      },
      "color": {
        "$type": "string",
        "$value": "transparent"
      },
      "control-width": {
        "$type": "dimension",
        "$value": "0"
      },
      "control-style": {
        "$type": "string",
        "$value": "none"
      },
      "control-color": {
        "$type": "string",
        "$value": "transparent"
      }
    },
    "elevation": {
      "$type": "shadow",
      "sm": {
        "$value": "0 1px 2px 0px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 32%, transparent), 0 1px 3px 1px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 22%, transparent)"
      },
      "md": {
        "$value": "0 2px 4px 0px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 26%, transparent), 0 6px 12px 0px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 22%, transparent), 0 12px 24px -4px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 18%, transparent)"
      },
      "lg": {
        "$value": "0 4px 8px 0px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 24%, transparent), 0 14px 28px 0px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 26%, transparent), 0 28px 56px -8px color-mix(in srgb, color-mix(in srgb, var(--idg-color-bg) 35%, black) 30%, transparent)"
      }
    },
    "surface": {
      "background": {
        "$type": "string",
        "$value": "var(--idg-color-surface)"
      },
      "backdrop-filter": {
        "$type": "string",
        "$value": "none"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "0"
      },
      "border-style": {
        "$type": "string",
        "$value": "none"
      },
      "border-color": {
        "$type": "string",
        "$value": "transparent"
      }
    },
    "focus": {
      "ring-width": {
        "$type": "dimension",
        "$value": "2px"
      },
      "ring-offset": {
        "$type": "dimension",
        "$value": "2px"
      },
      "ring-style": {
        "$type": "string",
        "$value": "solid"
      }
    },
    "ornament": {
      "heading-transform": {
        "$type": "string",
        "$value": "none"
      },
      "heading-decoration": {
        "$type": "string",
        "$value": "none"
      },
      "control-transform": {
        "$type": "string",
        "$value": "none"
      },
      "hard-shadow-x": {
        "$type": "dimension",
        "$value": "0px"
      },
      "hard-shadow-y": {
        "$type": "dimension",
        "$value": "0px"
      }
    }
  }
}
