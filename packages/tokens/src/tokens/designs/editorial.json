{
  "$description": "Print-like: square corners, no shadow, surfaces divided only by rules above and below, underlined headings.",
  "$extensions": {
    "identgineer": {
      "label": "Editorial"
    }
  },
  "tokens": {
    "shape": {
      "$type": "dimension",
      "radius": {
        "sm": {
          "$value": "0"
        },
        "md": {
          "$value": "0"
        },
        "lg": {
          "$value": "0"
        },
        "pill": {
          "$value": "0"
        }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": "1px"
      },
      "style": {
        "$type": "string",
        "$value": "solid"
      },
      "color": {
        "$type": "string",
        "$value": "var(--idg-color-border)"
      },
      "control-width": {
        "$type": "dimension",
        "$value": "0 0 1px"
      },
      "control-style": {
        "$type": "string",
        "$value": "solid"
      },
      "control-color": {
        "$type": "string",
        "$value": "var(--idg-color-border-strong)"
      }
    },
    "elevation": {
      "$type": "shadow",
      "sm": {
        "$value": "none"
      },
      "md": {
        "$value": "none"
      },
      "lg": {
        "$value": "none"
      }
    },
    "surface": {
      "background": {
        "$type": "string",
        "$value": "transparent"
      },
      "backdrop-filter": {
        "$type": "string",
        "$value": "none"
      },
      "border-width": {
        "$type": "dimension",
        "$value": "1px 0"
      },
      "border-style": {
        "$type": "string",
        "$value": "solid"
      },
      "border-color": {
        "$type": "string",
        "$value": "var(--idg-color-border-strong)"
      }
    },
    "focus": {
      "ring-width": {
        "$type": "dimension",
        "$value": "2px"
      },
      "ring-offset": {
        "$type": "dimension",
        "$value": "3px"
      },
      "ring-style": {
        "$type": "string",
        "$value": "solid"
      }
    },
    "ornament": {
      "heading-transform": {
        "$type": "string",
        "$value": "none"
      },
      "heading-decoration": {
        "$type": "string",
        "$value": "underline"
      },
      "control-transform": {
        "$type": "string",
        "$value": "none"
      },
      "hard-shadow-x": {
        "$type": "dimension",
        "$value": "0px"
      },
      "hard-shadow-y": {
        "$type": "dimension",
        "$value": "0px"
      }
    }
  }
}
