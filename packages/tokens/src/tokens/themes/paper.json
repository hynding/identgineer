{
  "$description": "Ink on warm paper in a book serif throughout, with very low chroma and a quiet voice.",
  "$extensions": {
    "identgineer": {
      "label": "Paper"
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": "{stack.serif-book}"
        },
        "body": {
          "$value": "{stack.serif-book}"
        },
        "mono": {
          "$value": "{stack.mono}"
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.medium}"
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.25
        }
      },
