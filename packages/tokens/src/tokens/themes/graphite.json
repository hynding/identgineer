      "on-success-subtle": {
        "$value": "{palette.green.200}"
      },
      "warning": {
        "$value": "{palette.amber.400}"
      },
      "on-warning": {
        "$value": "{palette.amber.950}"
      },
      "warning-subtle": {
        "$value": "{palette.amber.900}"
      },
      "on-warning-subtle": {
        "$value": "{palette.amber.200}"
      },
      "danger": {
        "$value": "{palette.red.400}"
      },
      "on-danger": {
        "$value": "{palette.red.950}"
      },
      "danger-subtle": {
        "$value": "{palette.red.900}"
