{
  "$description": "Strict neutral greys with a single electric blue accent and a tight, heavy grotesque.",
  "$extensions": {
    "identgineer": {
      "label": "Graphite"
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": "{stack.grotesque}"
        },
        "body": {
          "$value": "{stack.grotesque}"
        },
        "mono": {
          "$value": "{stack.mono}"
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.bold}"
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "-0.035em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.05
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "-0.005em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.5
        }
      }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#f4f4f5"
      },
      "bg-subtle": {
        "$value": "#e9e9eb"
      },
      "surface": {
        "$value": "#ffffff"
      },
      "surface-raised": {
        "$value": "#ffffff"
      },
      "text": {
        "$value": "#111113"
      },
      "text-muted": {
        "$value": "#50505a"
      },
      "border": {
        "$value": "#d4d4d8"
      },
      "border-strong": {
        "$value": "#7b7b86"
      },
      "accent": {
        "$value": "#0a4fff"
      },
      "accent-hover": {
        "$value": "#0039cc"
      },
      "on-accent": {
        "$value": "#ffffff"
      },
      "accent-subtle": {
        "$value": "#dbe5ff"
      },
      "on-accent-subtle": {
        "$value": "#0a2a8a"
      },
      "accent-indicator": {
        "$value": "#0a4fff"
      },
      "on-accent-indicator": {
        "$value": "#ffffff"
      },
      "accent-border": {
        "$value": "#0a4fff"
      },
      "link": {
        "$value": "#0a4fff"
      },
      "focus-ring": {
        "$value": "#0a4fff"
      },
      "success": {
        "$value": "{palette.green.700}"
      },
      "on-success": {
        "$value": "{palette.neutral.0}"
      },
      "success-subtle": {
        "$value": "{palette.green.100}"
      },
      "on-success-subtle": {
        "$value": "{palette.green.900}"
      },
      "warning": {
        "$value": "{palette.amber.400}"
      },
      "on-warning": {
        "$value": "{palette.amber.950}"
      },
      "warning-subtle": {
        "$value": "{palette.amber.100}"
      },
      "on-warning-subtle": {
        "$value": "{palette.amber.900}"
      },
      "danger": {
        "$value": "{palette.red.600}"
      },
      "on-danger": {
        "$value": "{palette.neutral.0}"
      },
      "danger-subtle": {
        "$value": "{palette.red.100}"
      },
      "on-danger-subtle": {
        "$value": "{palette.red.900}"
      },
      "info": {
        "$value": "{palette.blue.600}"
      },
      "on-info": {
        "$value": "{palette.neutral.0}"
      },
      "info-subtle": {
        "$value": "{palette.blue.100}"
      },
      "on-info-subtle": {
        "$value": "{palette.blue.900}"
      }
    },
    "gradient": {
      "brand": {
        "$type": "gradient",
        "$value": [
          {
            "color": "#111113",
            "position": 0
          },
          {
            "color": "#50505a",
            "position": 0.5
          },
          {
            "color": "#0a4fff",
            "position": 1
          }
        ]
      }
    }
  },
  "dark": {
