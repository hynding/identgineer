        "$value": "{palette.red.950}"
      },
      "danger-subtle": {
        "$value": "{palette.red.900}"
      },
      "on-danger-subtle": {
        "$value": "{palette.red.200}"
      },
      "info": {
        "$value": "{palette.blue.400}"
