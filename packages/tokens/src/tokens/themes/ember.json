{
  "$description": "Terracotta and warm cream with a classical serif display over a friendly sans body.",
  "$extensions": {
    "identgineer": {
      "label": "Ember"
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": "{stack.serif-old-style}"
        },
        "body": {
          "$value": "{stack.system-sans}"
        },
        "mono": {
          "$value": "{stack.mono}"
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.semibold}"
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "-0.01em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.15
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.65
        }
      }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#fbf4ea"
      },
      "bg-subtle": {
        "$value": "#f3e7d6"
      },
      "surface": {
        "$value": "#fffaf2"
      },
      "surface-raised": {
        "$value": "#ffffff"
      },
      "text": {
        "$value": "#2e1a12"
      },
      "text-muted": {
        "$value": "#6a4a3a"
      },
      "border": {
        "$value": "#e3cfb8"
      },
      "border-strong": {
        "$value": "#a07a5e"
      },
      "accent": {
        "$value": "#b8482a"
      },
      "accent-hover": {
        "$value": "#983a20"
      },
      "on-accent": {
        "$value": "#fffaf2"
      },
      "accent-subtle": {
        "$value": "#f6d9c9"
      },
      "on-accent-subtle": {
        "$value": "#6e2410"
      },
      "link": {
        "$value": "#a23a1e"
      },
      "focus-ring": {
        "$value": "#c2410c"
      },
      "success": {
        "$value": "{palette.green.700}"
      },
      "on-success": {
        "$value": "{palette.neutral.0}"
      },
      "success-subtle": {
        "$value": "{palette.green.100}"
      },
      "on-success-subtle": {
        "$value": "{palette.green.900}"
      },
      "warning": {
        "$value": "{palette.amber.400}"
      },
      "on-warning": {
        "$value": "{palette.amber.950}"
      },
      "warning-subtle": {
        "$value": "{palette.amber.100}"
      },
      "on-warning-subtle": {
        "$value": "{palette.amber.900}"
      },
      "danger": {
        "$value": "{palette.red.600}"
      },
      "on-danger": {
        "$value": "{palette.neutral.0}"
      },
      "danger-subtle": {
        "$value": "{palette.red.100}"
      },
      "on-danger-subtle": {
        "$value": "{palette.red.900}"
      },
      "info": {
        "$value": "{palette.blue.600}"
      },
      "on-info": {
        "$value": "{palette.neutral.0}"
      },
      "info-subtle": {
        "$value": "{palette.blue.100}"
      },
      "on-info-subtle": {
        "$value": "{palette.blue.900}"
      }
    },
    "gradient": {
      "brand": {
        "$type": "gradient",
        "$value": [
          {
            "color": "#e9833f",
            "position": 0
          },
          {
            "color": "#b8482a",
            "position": 0.5
          },
          {
            "color": "#7a2e2a",
            "position": 1
          }
        ]
      }
    }
  },
  "dark": {
