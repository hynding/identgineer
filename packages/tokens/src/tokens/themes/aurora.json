      },
      "on-accent": {
        "$value": "#ffffff"
      },
      "accent-subtle": {
        "$value": "#e4e2ff"
      },
      "on-accent-subtle": {
        "$value": "#2e2a9c"
      },
      "link": {
        "$value": "#4338ca"
      },
      "focus-ring": {
        "$value": "#4f46e5"
