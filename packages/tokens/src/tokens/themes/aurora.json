        "$value": "#ffffff"
      },
      "surface-raised": {
        "$value": "#ffffff"
      },
      "text": {
        "$value": "#14123a"
      },
      "text-muted": {
        "$value": "#4a4878"
      },
      "border": {
        "$value": "#d8d8ee"
      },
      "border-strong": {
        "$value": "#8583b8"
      },
      "accent": {
        "$value": "#4f46e5"
      },
