{
  "$description": "Deep indigo with teal-to-violet gradient accents and a clean geometric sans. The default theme.",
  "$extensions": {
    "identgineer": {
      "label": "Aurora"
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": "{stack.geometric}"
        },
        "body": {
          "$value": "{stack.geometric}"
        },
        "mono": {
          "$value": "{stack.mono}"
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.semibold}"
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "-0.02em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.15
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.6
        }
      }
    }
  },
  "light": {
    "color": {
      "$type": "color",
      "bg": {
        "$value": "#f7f7fd"
      },
      "bg-subtle": {
        "$value": "#eeeefa"
      },
