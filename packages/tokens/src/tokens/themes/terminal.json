{
  "$description": "Phosphor green and amber on near-black, or a pale console in the light scheme, in monospace throughout.",
  "$extensions": {
    "identgineer": {
      "label": "Terminal"
    }
  },
  "common": {
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": {
          "$value": "{stack.mono}"
        },
        "body": {
          "$value": "{stack.mono}"
        },
        "mono": {
          "$value": "{stack.mono}"
        }
      },
      "display": {
        "weight": {
          "$type": "fontWeight",
          "$value": "{font.weight.bold}"
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.3
        }
      },
      "body": {
        "letter-spacing": {
          "$type": "dimension",
          "$value": "0em"
        },
        "line-height": {
          "$type": "number",
          "$value": 1.55
        }
      }
    }
  },
  "light": {
