{
  "$description": "The densest layout, keyboard shortcut hints on, the fastest motion and the smallest allowed targets.",
  "$extensions": {
    "identgineer": {
      "label": "Power"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "1.75rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "0.5rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.125rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 0.5
      },
      "measure": {
        "$type": "dimension",
        "$value": "100ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 0.875
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 1
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "40ms"
        },
        "base": {
          "$value": "80ms"
        },
        "slow": {
          "$value": "120ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0, 0, 0.2, 1]
        },
        "emphasized": {
          "$value": [0, 0, 0.2, 1]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "0px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.99
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1
      }
    }
  }
}
