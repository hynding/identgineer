{
  "$description": "Near-zero motion: no lift or press, and only slow, gentle fades.",
  "$extensions": {
    "identgineer": {
      "label": "Calm"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.625rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1.25
      },
      "measure": {
        "$type": "dimension",
        "$value": "62ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "200ms"
        },
        "base": {
          "$value": "400ms"
        },
        "slow": {
          "$value": "700ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.4, 0, 0.2, 1]
        },
        "emphasized": {
          "$value": [0.4, 0, 0.2, 1]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 0
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "0px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 1
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1
      }
    }
  }
}
