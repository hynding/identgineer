{
  "$description": "One thing at a time: very large targets and type, a narrow measure and a thick focus ring.",
  "$extensions": {
    "identgineer": {
      "label": "Focus"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "3.5rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "3.5rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1.6
      },
      "measure": {
        "$type": "dimension",
        "$value": "52ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1.25
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "100ms"
        },
        "base": {
          "$value": "160ms"
        },
        "slow": {
          "$value": "240ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.2, 0, 0, 1]
        },
        "emphasized": {
          "$value": [0.3, 0, 0.8, 0.15]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "0px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.98
      },
      "hover-delay": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 2
      }
    }
  }
}
