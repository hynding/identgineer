{
  "$description": "Generous spacing, larger type, bigger controls and a longer measure.",
  "$extensions": {
    "identgineer": {
      "label": "Spacious"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "3rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1.4
      },
      "measure": {
        "$type": "dimension",
        "$value": "75ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1.125
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "150ms"
        },
        "base": {
          "$value": "250ms"
        },
        "slow": {
          "$value": "400ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.2, 0, 0, 1]
        },
        "emphasized": {
          "$value": [0.3, 0, 0.8, 0.15]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "2px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.98
      },
      "hover-delay": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1.25
      }
    }
  }
}
