{
  "$description": "Tight spacing, smaller controls, a wide measure and short motion for information-dense screens.",
  "$extensions": {
    "identgineer": {
      "label": "Compact"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "1.75rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.25rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 0.7
      },
      "measure": {
        "$type": "dimension",
        "$value": "80ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 0.9375
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "80ms"
        },
        "base": {
          "$value": "140ms"
        },
        "slow": {
          "$value": "220ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.3, 0, 0.2, 1]
        },
        "emphasized": {
          "$value": [0.4, 0, 0.6, 1]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "0px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.99
      },
      "hover-delay": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1
      }
    }
  }
}
