{
  "$description": "Balanced spacing, 40px controls and unhurried, standard motion. The default.",
  "$extensions": {
    "identgineer": {
      "label": "Comfortable"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.5rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1
      },
      "measure": {
        "$type": "dimension",
        "$value": "68ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "120ms"
        },
        "base": {
          "$value": "200ms"
        },
        "slow": {
          "$value": "320ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.2, 0, 0, 1]
        },
        "emphasized": {
          "$value": [0.3, 0, 0.8, 0.15]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "1px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.98
      },
      "hover-delay": {
        "$type": "duration",
        "$value": "500ms"
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1
      }
    }
  }
}
