{
  "$description": "Hints on by default, generous spacing, an emphasised focus ring and medium motion.",
  "$extensions": {
    "identgineer": {
      "label": "Guided"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.625rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1.3
      },
      "measure": {
        "$type": "dimension",
        "$value": "64ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1.0625
      },
      "hints": {
        "$value": 1
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "130ms"
        },
        "base": {
          "$value": "240ms"
        },
        "slow": {
          "$value": "380ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.2, 0, 0, 1]
        },
        "emphasized": {
          "$value": [0.3, 0, 0.8, 0.15]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "2px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.97
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1.5
      }
    }
  }
}
