{
  "$description": "Springy overshoot easing, a bigger hover lift, a squashing press and longer durations.",
  "$extensions": {
    "identgineer": {
      "label": "Playful"
    }
  },
  "tokens": {
    "density": {
      "target-size": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-height": {
        "$type": "dimension",
        "$value": "2.75rem"
      },
      "control-padding-inline": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "control-padding-block": {
        "$type": "dimension",
        "$value": "0.625rem"
      },
      "gap-scale": {
        "$type": "number",
        "$value": 1.15
      },
      "measure": {
        "$type": "dimension",
        "$value": "64ch"
      }
    },
    "ux": {
      "$type": "number",
      "type-scale": {
        "$value": 1.0625
      },
      "hints": {
        "$value": 0
      },
      "shortcuts": {
        "$value": 0
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "fast": {
          "$value": "180ms"
        },
        "base": {
          "$value": "300ms"
        },
        "slow": {
          "$value": "500ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [0.34, 1.56, 0.64, 1]
        },
        "emphasized": {
          "$value": [0.68, -0.6, 0.32, 1.6]
        }
      },
      "enabled": {
        "$type": "number",
        "$value": 1
      }
    },
    "feedback": {
      "hover-lift": {
        "$type": "dimension",
        "$value": "4px"
      },
      "press-scale": {
        "$type": "number",
        "$value": 0.92
      }
    },
    "focus": {
      "$type": "number",
      "emphasis": {
        "$value": 1
      }
    }
  }
}
