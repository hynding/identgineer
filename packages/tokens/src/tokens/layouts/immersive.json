{
  "$description": "Content runs edge to edge in very wide tracks, with large section gaps and minimal chrome.",
  "$extensions": {
    "identgineer": {
      "label": "Immersive"
    }
  },
  "tokens": {
    "layout": {
      "$type": "dimension",
      "content-max": {
        "$value": "100%"
      },
      "page-gutter": {
        "$value": "{space.s}"
      },
      "section-gap": {
        "$value": "{space.3xl}"
      },
      "gap": {
        "$value": "{space.s}"
      },
      "columns": {
        "$type": "number",
        "$value": 3
      },
      "grid-min": {
        "$value": "22rem"
      },
      "aside-width": {
        "$value": "28rem"
      },
      "nav-size": {
        "$value": "3rem"
      },
      "rail-width": {
        "$value": "20rem"
      },
      "sticky-inset": {
        "$value": "0"
      },
      "shell": {
        "$type": "string",
        "$value": "immersive"
      }
    }
  }
}
