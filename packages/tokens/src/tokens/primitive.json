  "stack": {
    "$type": "fontFamily",
    "system-sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "geometric": {
      "$value": [
        "Avenir Next",
        "Avenir",
        "Century Gothic",
        "Futura",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ]
    },
    "humanist": {
      "$value": [
        "Seravek",
        "Gill Sans Nova",
        "Gill Sans",
        "Trebuchet MS",
        "Candara",
        "Segoe UI",
        "system-ui",
        "sans-serif"
      ]
    },
    "grotesque": {
      "$value": ["Helvetica Neue", "Helvetica", "Arial", "Liberation Sans", "sans-serif"]
    },
    "heavy-sans": {
      "$value": ["Arial Black", "Segoe UI Black", "Helvetica Neue", "Arial", "sans-serif"]
    },
    "serif-old-style": {
      "$value": [
        "Iowan Old Style",
        "Palatino Linotype",
        "Palatino",
        "Book Antiqua",
        "Georgia",
        "serif"
      ]
    },
    "serif-didone": {
      "$value": ["Didot", "Bodoni 72", "Bodoni MT", "Playfair Display", "Times New Roman", "serif"]
    },
    "serif-book": {
      "$value": ["Charter", "Bitstream Charter", "Sitka Text", "Cambria", "Georgia", "serif"]
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SF Mono",
        "Cascadia Code",
        "Menlo",
        "Consolas",
        "DejaVu Sans Mono",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "font": {
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300
      },
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "black": {
        "$value": 900
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.7
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.03em"
      },
      "snug": {
        "$value": "-0.015em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.04em"
      },
      "wider": {
        "$value": "0.08em"
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid type scale, 320px to 1280px viewports; minor third growing to major third.",
      "step-neg1": {
        "$value": "clamp(0.833rem, 0.811rem + 0.111vw, 0.9rem)"
      },
      "step-0": {
        "$value": "clamp(1rem, 0.958rem + 0.208vw, 1.125rem)"
      },
      "step-1": {
        "$value": "clamp(1.2rem, 1.131rem + 0.344vw, 1.406rem)"
      },
      "step-2": {
        "$value": "clamp(1.44rem, 1.334rem + 0.53vw, 1.758rem)"
      },
      "step-3": {
        "$value": "clamp(1.728rem, 1.572rem + 0.782vw, 2.197rem)"
      },
      "step-4": {
        "$value": "clamp(2.074rem, 1.849rem + 1.122vw, 2.747rem)"
      },
      "step-5": {
        "$value": "clamp(2.488rem, 2.173rem + 1.575vw, 3.433rem)"
      },
      "step-6": {
        "$value": "clamp(2.986rem, 2.551rem + 2.176vw, 4.292rem)"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Fluid space scale, 320px to 1280px viewports.",
    "3xs": {
      "$value": "clamp(0.25rem, 0.24rem + 0.052vw, 0.281rem)"
    },
    "2xs": {
      "$value": "clamp(0.5rem, 0.479rem + 0.104vw, 0.563rem)"
    },
    "xs": {
      "$value": "clamp(0.75rem, 0.719rem + 0.156vw, 0.844rem)"
    },
    "s": {
      "$value": "clamp(1rem, 0.958rem + 0.208vw, 1.125rem)"
    },
    "m": {
      "$value": "clamp(1.5rem, 1.438rem + 0.313vw, 1.688rem)"
    },
    "l": {
      "$value": "clamp(2rem, 1.917rem + 0.417vw, 2.25rem)"
    },
    "xl": {
      "$value": "clamp(3rem, 2.875rem + 0.625vw, 3.375rem)"
    },
    "2xl": {
      "$value": "clamp(4rem, 3.833rem + 0.833vw, 4.5rem)"
    },
    "3xl": {
      "$value": "clamp(6rem, 5.75rem + 1.25vw, 6.75rem)"
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Fixed size scale for container widths and heights: track minimums, side regions, switch thresholds and cover heights.",
    "xs": {
      "$value": "10rem"
    },
    "s": {
      "$value": "14rem"
    },
    "m": {
      "$value": "20rem"
    },
    "l": {
      "$value": "28rem"
    },
    "xl": {
      "$value": "40rem"
    },
    "2xl": {
      "$value": "56rem"
    },
    "3xl": {
      "$value": "72rem"
    },
    "screen": {
      "$value": "100svh",
      "$description": "The height of the small viewport, for a block that fills the screen."
    }
  }
}
