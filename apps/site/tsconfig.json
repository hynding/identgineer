{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "paths": { "@identgineer/components": ["../../packages/components/src/index.ts"] }
  },
  "include": ["src", "scripts", "checks", "browser", "*.config.ts"],
  "exclude": ["node_modules", "www", "hydrate"]
}
