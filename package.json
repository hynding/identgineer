{
  "name": "identgineer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.7"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json && tsc -p cms/tsconfig.json && tsc -p cms/tsconfig.strapi.json",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "cms:validate": "node cms/scripts/camis.js validate camis.json",
    "cms:generate": "node cms/scripts/camis.js generate --config camis.config.json",
    "cms:build": "node cms/scripts/camis.js build --config camis.config.json",
    "contract:live": "node cms/scripts/live-backend.js -- vitest run --project identity-live"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
